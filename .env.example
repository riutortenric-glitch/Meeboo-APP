# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the app — never put secrets there.

# Clerk — https://dashboard.clerk.com (enable Apple + Google)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Sentry
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Neon Postgres (server-only)
DATABASE_URL=

# Trigger.dev (server-only)
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# OpenAI (server-only, phase 1+)
OPENAI_API_KEY=

# ImageKit (phase 4)
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
